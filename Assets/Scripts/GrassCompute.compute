#pragma kernel CSMain

struct GrassData
{
    float4 posAndScale; // xyz - локальная позиция, w - масштаб
    float4 rotAndPad; // x - поворот (радианы)
};

RWStructuredBuffer<GrassData> grassOutputBuffer;

float terrainStartX, terrainEndX;
float terrainStartZ, terrainEndZ;
float heightScale;
float noiseScale;
float grassStep;
float perlinOffsetX, perlinOffsetZ;
int maxGrassPoints;
float flatZoneRadius;
float blendZone;
float grassMinScale;
float grassMaxScale;

StructuredBuffer<float> distanceField;
int gridSize;

float hash(float2 p)
{
    return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

float2 hash2(float2 p)
{
    float2 h = float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)));
    return -1.0 + 2.0 * frac(sin(h) * 43758.5453);
}

float perlinNoise(float2 p)
{
    float2 i = floor(p);
    float2 f = frac(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return lerp(
        lerp(dot(hash2(i + float2(0.0, 0.0)), f - float2(0.0, 0.0)),
             dot(hash2(i + float2(1.0, 0.0)), f - float2(1.0, 0.0)), u.x),
        lerp(dot(hash2(i + float2(0.0, 1.0)), f - float2(0.0, 1.0)),
             dot(hash2(i + float2(1.0, 1.0)), f - float2(1.0, 1.0)), u.x), u.y);
}

[numthreads(64, 1, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index >= (uint) maxGrassPoints)
        return;

    float w = terrainEndX - terrainStartX;
    float l = terrainEndZ - terrainStartZ;
    uint cellsX = (uint) (w / grassStep);
    uint cellsZ = (uint) (l / grassStep);
    if (cellsX == 0u || cellsZ == 0u)
        return;

    uint cx = index % cellsX;
    uint cz = index / cellsX;

    float jitterX = hash(float2((float) index, 0.0));
    float jitterZ = hash(float2(0.0, (float) index));

    float x = terrainStartX + ((float) cx + jitterX) * grassStep;
    float z = terrainStartZ + ((float) cz + jitterZ) * grassStep;

    // Distance field (без интерполяции, для скорости)
    float u = (x - terrainStartX) / w;
    float v = (z - terrainStartZ) / l;
    int dx = clamp((int) (u * (float) (gridSize - 1)), 0, gridSize - 1);
    int dz = clamp((int) (v * (float) (gridSize - 1)), 0, gridSize - 1);
    float dist = distanceField[dz * gridSize + dx];

    if (dist < flatZoneRadius)
    {
        // Скрываем травинку
        GrassData hidden;
        hidden.posAndScale = float4(0, -10000, 0, 0);
        hidden.rotAndPad = float4(0, 0, 0, 0);
        grassOutputBuffer[index] = hidden;
        return;
    }

    float noiseX = (x + perlinOffsetX) * noiseScale;
    float noiseZ = (z + perlinOffsetZ) * noiseScale;
    float y = (perlinNoise(float2(noiseX, noiseZ)) * 0.5 + 0.5) * heightScale;

    float fade = 1.0;
    if (dist < flatZoneRadius + blendZone)
        fade = saturate((dist - flatZoneRadius) / blendZone);

    float scaleNorm = hash(float2((float) index, (float) index));
    float scale = lerp(grassMinScale, grassMaxScale, scaleNorm) * fade;
    float rotation = hash(float2(z, x)) * 6.28318; // 2*PI радиан

    GrassData data;
    data.posAndScale = float4(x, y, z, scale);
    data.rotAndPad = float4(rotation, 0, 0, 0);

    grassOutputBuffer[index] = data;
}